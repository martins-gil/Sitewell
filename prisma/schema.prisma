// Sitepilot — Clinical Trial Site Platform
// Prisma schema per PROJECT_SPEC.md section 3.
// Row-level security (organization_id isolation) and the audit-log trigger
// are added as raw SQL in prisma/migrations/<ts>_rls_and_audit/migration.sql
// — Prisma's schema language cannot express RLS policies or triggers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: the least-privilege app_runtime role (RLS-bound).
  url       = env("DATABASE_URL")
  // Migrations/seed connection: the owner role (full privileges, bypasses RLS).
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CRC
  PI
  ORG_ADMIN
  PLATFORM_ADMIN
}

enum SubjectStatus {
  IDENTIFIED
  PRE_SCREENED
  SCREENED
  CONSENTED
  ENROLLED
  SCREEN_FAILED
  WITHDRAWN
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  MISSED
  RESCHEDULED
}

enum DocumentType {
  PROTOCOL
  IB
  ICF
  DELEGATION_LOG
  TRAINING_RECORD
  OTHER
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUPERSEDED
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

enum FeedbackArea {
  RECRUITMENT
  VISITS
  DOCUMENTS
  STUDIES
  LOGIN_AND_SECURITY
  OTHER
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  plan                String   @default("pilot")
  region              String?
  hostingPreference   String?  @map("hosting_preference")
  // The organization's own wording for the weekly visit email and text message
  // ({ emailSubject, emailBody, smsBody }, validated by src/lib/visit-alert-templates.ts);
  // null = the built-in wording. Edited by an org admin under Settings → Notifications.
  visitAlertTemplates Json?    @map("visit_alert_templates")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  users                User[]
  studies              Study[]
  sites                Site[]
  subjects             Subject[]
  studyAssignments     StudyAssignment[]
  templates            VisitScheduleTemplate[]
  visits               Visit[]
  documents            Document[]
  feedbackSubmissions  FeedbackSubmission[]
  checklistItems       ChecklistTemplateItem[]
  checklistResults     VisitChecklistResult[]
  checklistTaskLibrary ChecklistTaskLibrary[]
  kits                 Kit[]
  departments          Department[]
  monitoringVisits     MonitoringVisit[]
  monitoringItems      MonitoringVisitItem[]
  labShipments         LabShipment[]

  @@map("organizations")
}

model User {
  id              String   @id @default(cuid())
  organizationId  String?  @map("organization_id")
  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  role            UserRole
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")

  mfaEnabled Boolean @default(false) @map("mfa_enabled")
  mfaSecret  String? @map("mfa_secret")

  // True while the user is on a password somebody else chose (a temporary one
  // set when the account was created or reset by an admin): they're nudged to
  // change it, and it clears when they do.
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  passwordChangedAt   DateTime? @map("password_changed_at")
  // Sign-in throttling: 5 wrong attempts in a row lock the account for 15
  // minutes (src/auth.ts). Reset by a correct sign-in or an admin password reset.
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lockedUntil         DateTime? @map("locked_until")
  // The user's private calendar link (Apple / Google / Outlook subscription,
  // src/lib/calendar-feed.ts). The link itself isn't stored: it's signed with
  // AUTH_SECRET and carries this version, so making a new link bumps the
  // version and the old one stops working, and turning it off blocks them all.
  calendarFeedEnabled Boolean   @default(false) @map("calendar_feed_enabled")
  calendarFeedVersion Int       @default(0) @map("calendar_feed_version")

  // Heads-up messages about the coming week's visits (src/lib/visit-digest.ts).
  // Email is on by default; a text message needs a phone number AND the person's
  // own opt-in (smsConsentAt records when they gave it). `phone` is in international
  // format (+351912345678). lastVisitDigestAt stops a retried job from sending twice.
  phone             String?
  notifyEmail       Boolean   @default(true) @map("notify_email")
  notifySms         Boolean   @default(false) @map("notify_sms")
  smsConsentAt      DateTime? @map("sms_consent_at")
  lastVisitDigestAt DateTime? @map("last_visit_digest_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization        Organization?        @relation(fields: [organizationId], references: [id])
  studyAssignments    StudyAssignment[]
  signedDocuments     Document[]           @relation("documentSigner")
  feedbackSubmissions FeedbackSubmission[]
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
  @@map("users")
}

model Study {
  id                    String    @id @default(cuid())
  organizationId        String    @map("organization_id")
  protocolId            String    @map("protocol_id")
  title                 String
  phase                 String?
  status                String    @default("active")
  sponsor               String?
  // DEPRECATED, unused: the protocol version/date now live on the study's
  // PROTOCOL document (see below). Kept only so the previous deploy keeps
  // working while the new one rolls out; drop in a follow-up migration once
  // that's done.
  protocolAmendment     String?   @map("protocol_amendment")
  protocolDate          DateTime? @map("protocol_date")
  // Printed on the generated checklist .docx (see src/lib/checklist-docx.ts).
  // Set directly on the study rather than derived from study_assignments —
  // it's a fixed fact about the study, not whoever's logged in. The protocol
  // VERSION and RELEASE DATE printed there are not stored here: they come
  // from the study's active PROTOCOL document (Document.version /
  // Document.releaseDate), see src/lib/protocol-document.ts.
  piName                String?   @map("pi_name")
  // The study's EU CT number (e.g. 2023-000000-00), printed in the footer of
  // the I/E criteria form (src/lib/ie-docx.ts).
  euCtNumber            String?   @map("eu_ct_number")
  // A palette id from src/lib/study-colors.ts (e.g. "blue"); null = one is
  // picked automatically. The calendar shows the study in this colour and each
  // of its patients in a different tone of it.
  color                 String?
  // The department (e.g. Oncology) the study belongs to; null = none set.
  departmentId          String?   @map("department_id")
  // The protocol's eligibility criteria, split into inclusion and exclusion:
  // { inclusion: string[], exclusion: string[] }. New patients of the study
  // can start from this list (each one "not assessed"). Null = none entered.
  ieCriteria            Json?     @map("ie_criteria")
  // Kit stock alert (src/lib/kit-stock.ts): when every kit of the study is assigned,
  // used or expired, the banner and the every-3-days email ask for more kits until
  // someone marks them as requested (kitRestockRequestedAt). Adding a kit clears it,
  // so the next time the stock runs out the alert comes back.
  kitRestockRequestedAt DateTime? @map("kit_restock_requested_at")
  lastKitStockEmailAt   DateTime? @map("last_kit_stock_email_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization     Organization            @relation(fields: [organizationId], references: [id])
  department       Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sites            Site[]
  subjects         Subject[]
  templates        VisitScheduleTemplate[]
  documents        Document[]
  assignments      StudyAssignment[]
  visits           Visit[]
  kits             Kit[]
  monitoringVisits MonitoringVisit[]
  labShipments     LabShipment[]

  @@unique([organizationId, protocolId])
  @@index([organizationId])
  @@index([departmentId])
  @@map("studies")
}

// A department of the site (Oncology, Cardiology…) that studies are assigned
// to, so the Studies page can count active studies and enrolments per
// department. Tenant-scoped: has RLS + the audit trigger (see its migration).
model Department {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  studies      Study[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Site {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  studyId        String?  @map("study_id")
  name           String
  address        String?
  siteNumber     String?  @map("site_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  study        Study?       @relation(fields: [studyId], references: [id])

  @@index([organizationId])
  @@map("sites")
}

model StudyAssignment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  studyId        String   @map("study_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id])
  study        Study        @relation(fields: [studyId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, studyId])
  @@index([organizationId])
  @@map("study_assignments")
}

model Subject {
  id                 String        @id @default(cuid())
  organizationId     String        @map("organization_id")
  studyId            String        @map("study_id")
  subjectCode        String        @map("subject_code")
  // Optional initials/name shown next to the subject code. Synthetic test
  // data only until Phase 5 (see PROJECT_SPEC.md) — the forms say so.
  displayName        String?       @map("display_name")
  status             SubjectStatus @default(IDENTIFIED)
  ieCriteriaSnapshot Json?         @map("ie_criteria_snapshot")
  isTestData         Boolean       @default(true) @map("is_test_data")
  enrolledAt         DateTime?     @map("enrolled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  study        Study        @relation(fields: [studyId], references: [id])
  visits       Visit[]
  documents    Document[]

  @@unique([studyId, subjectCode])
  @@index([organizationId])
  @@index([studyId, status])
  @@map("subjects")
}

model VisitScheduleTemplate {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  studyId           String   @map("study_id")
  name              String
  targetDayOffset   Int      @map("target_day_offset")
  windowBeforeDays  Int      @default(0) @map("window_before_days")
  windowAfterDays   Int      @default(0) @map("window_after_days")
  sortOrder         Int      @default(0) @map("sort_order")
  // Printed on this visit type's checklist .docx: the "(V3)" after the
  // heading, and the footnote under the table (e.g. "*hematologia, BQ, ...").
  checklistVersion  String?  @map("checklist_version")
  checklistFootnote String?  @map("checklist_footnote")
  // Which last column this visit type's checklist document has: "VERIFIED"
  // (a tick) or "DATETIME" (the date and time each procedure was done). A
  // plain string rather than an enum — two values, validated where it's set.
  checklistColumn   String   @default("VERIFIED") @map("checklist_column")
  // The standard nursing record ("Documento fonte - Registos de enfermagem")
  // for this visit type: sections of rows to fill in by hand. Shape and
  // validation live in src/lib/nursing-sheet.ts.
  nursingSheet      Json?    @map("nursing_sheet")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  study          Study                   @relation(fields: [studyId], references: [id])
  visits         Visit[]
  organization   Organization            @relation(fields: [organizationId], references: [id])
  checklistItems ChecklistTemplateItem[]
  kits           Kit[]

  @@index([organizationId])
  @@index([studyId])
  @@map("visit_schedule_templates")
}

// One row per procedure/assessment step on a visit type's paper checklist
// (e.g. "Registo no IWRS", "Colheita de sangue"). Belongs to the visit TYPE
// (VisitScheduleTemplate), not to an individual subject's visit — every
// subject's "Baseline" visit shares the same checklist definition.
model ChecklistTemplateItem {
  id                      String   @id @default(cuid())
  organizationId          String   @map("organization_id")
  visitScheduleTemplateId String   @map("visit_schedule_template_id")
  sortOrder               Int      @default(0) @map("sort_order")
  label                   String
  detail                  String?
  createdAt               DateTime @default(now()) @map("created_at")

  visitScheduleTemplate VisitScheduleTemplate  @relation(fields: [visitScheduleTemplateId], references: [id])
  organization          Organization           @relation(fields: [organizationId], references: [id])
  results               VisitChecklistResult[]

  @@index([organizationId])
  @@index([visitScheduleTemplateId])
  @@map("checklist_template_items")
}

// A reusable catalog of checklist step descriptions, org-wide, so adding a
// checklist item to a new visit type can pick from what other templates
// already use instead of retyping the same wording every time. Purely a
// suggestion source for the "Add a checklist item" form — copying a library
// entry into a template does not link back to it, so editing/removing a
// library entry never touches templates that already used it.
model ChecklistTaskLibrary {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  label          String
  detail         String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, label])
  @@index([organizationId])
  @@map("checklist_task_library")
}

// Physical/lab kit inventory — a kit (or batch) with an expiry date, which
// can be earmarked for a visit TYPE (visitScheduleTemplateId, e.g. "Baseline
// blood draw kits, Lot #4521") and/or assigned to one specific subject's
// visit (visitId). Not a full per-subject dispensing log — visitId is just
// "this kit is set aside for / was used at that visit".
//
// orderedAt: someone acknowledged a replacement was ordered — stops the
// expiry banner and the every-3-days email for this kit.
// usedAt: soft-removed from inventory once used (only allowed after the
// linked visit has an actualDate) — kept as a row so history isn't lost, and
// excluded from expiry alerts/counts.
// lastExpiryEmailAt: when the expiry reminder email last went out for this
// kit, so the cron job can space them 3 days apart.
model Kit {
  id                      String    @id @default(cuid())
  organizationId          String    @map("organization_id")
  studyId                 String    @map("study_id")
  visitScheduleTemplateId String?   @map("visit_schedule_template_id")
  visitId                 String?   @map("visit_id")
  // The lab shipment this kit's samples went out in (Lab samples); null = not shipped.
  shipmentId              String?   @map("shipment_id")
  name                    String
  expiryDate              DateTime? @map("expiry_date")
  orderedAt               DateTime? @map("ordered_at")
  usedAt                  DateTime? @map("used_at")
  lastExpiryEmailAt       DateTime? @map("last_expiry_email_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  organization          Organization           @relation(fields: [organizationId], references: [id])
  study                 Study                  @relation(fields: [studyId], references: [id])
  visitScheduleTemplate VisitScheduleTemplate? @relation(fields: [visitScheduleTemplateId], references: [id])
  visit                 Visit?                 @relation(fields: [visitId], references: [id], onDelete: SetNull)
  shipment              LabShipment?           @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([studyId])
  @@index([visitId])
  @@index([shipmentId])
  @@map("kits")
}

// A shipment of laboratory samples sent out under an airway bill (AWB), with how many
// samples went at each temperature. The samples come from the kits used at patient
// visits, so a shipment can list those kits (Kit.shipmentId). The counts are typed in,
// not derived from the kits. Tenant-scoped: RLS + the audit trigger (see its migration).
model LabShipment {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  studyId           String   @map("study_id")
  // Upper-case, one per organization.
  awb               String
  // The day it went out — noon UTC, like every date-only value here.
  shipDate          DateTime @map("ship_date")
  ambientCount      Int      @default(0) @map("ambient_count")
  refrigeratedCount Int      @default(0) @map("refrigerated_count")
  frozenCount       Int      @default(0) @map("frozen_count")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  study        Study        @relation(fields: [studyId], references: [id])
  kits         Kit[]

  @@unique([organizationId, awb])
  @@index([organizationId])
  @@index([studyId, shipDate])
  @@map("lab_shipments")
}

model Visit {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  subjectId      String      @map("subject_id")
  studyId        String      @map("study_id")
  templateId     String?     @map("template_id")
  visitType      String      @map("visit_type")
  targetDate     DateTime    @map("target_date")
  // The time of day the visit is booked for, "HH:mm" as on the clinic's wall
  // clock (a floating time: no time zone, the same way visit dates are day-only).
  // Null = no time set, and the visit shows as all-day in a shared calendar.
  startTime      String?     @map("start_time")
  windowStart    DateTime    @map("window_start")
  windowEnd      DateTime    @map("window_end")
  actualDate     DateTime?   @map("actual_date")
  // Free-text notes the coordinator keeps on this visit; also printed at the
  // end of the visit's documents.
  notes          String?
  status         VisitStatus @default(SCHEDULED)
  reminderSentAt DateTime?   @map("reminder_sent_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  subject          Subject                @relation(fields: [subjectId], references: [id])
  study            Study                  @relation(fields: [studyId], references: [id])
  template         VisitScheduleTemplate? @relation(fields: [templateId], references: [id])
  organization     Organization           @relation(fields: [organizationId], references: [id])
  documents        Document[]
  checklistResults VisitChecklistResult[]
  kits             Kit[]

  @@index([organizationId])
  @@index([studyId, targetDate])
  @@index([subjectId])
  @@map("visits")
}

// One row per checklist line on a specific subject's visit — the
// "Verificado" checkbox state, plus the item's label/detail/sortOrder
// denormalized at creation time. Most rows are created lazily from the
// visit type's ChecklistTemplateItem list the first time the visit's
// checklist is viewed (see getVisitChecklist in queries.ts), but
// templateItemId is nullable so a coordinator can also add a one-off
// procedure to just this visit (visits are not static — an unplanned extra
// step, or one that doesn't apply this time) without touching the shared
// template that every other subject's visit of that type uses.
// `removed` is a soft-delete: for a template-derived row it has to survive
// (not be hard-deleted) so the lazy-creation pass in getVisitChecklist
// doesn't see a "missing" template item and recreate it every time this
// visit's checklist is viewed.
model VisitChecklistResult {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  visitId        String    @map("visit_id")
  templateItemId String?   @map("template_item_id")
  label          String
  detail         String?
  sortOrder      Int       @default(0) @map("sort_order")
  verified       Boolean   @default(false)
  // When the procedure was done. A "floating" wall-clock value: the digits the
  // coordinator entered, stored as if UTC and shown back the same way, so it
  // reads identically on every device and on the printed document.
  performedAt    DateTime? @map("performed_at")
  removed        Boolean   @default(false)
  updatedAt      DateTime  @updatedAt @map("updated_at")

  visit        Visit                  @relation(fields: [visitId], references: [id])
  templateItem ChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  organization Organization           @relation(fields: [organizationId], references: [id])

  @@unique([visitId, templateItemId])
  @@index([organizationId])
  @@map("visit_checklist_results")
}

model Document {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  studyId        String         @map("study_id")
  subjectId      String?        @map("subject_id")
  visitId        String?        @map("visit_id")
  type           DocumentType
  // The user's own name for the type when `type` is OTHER (e.g. "Lab
  // certificate"); null for the standard types.
  typeLabel      String?        @map("type_label")
  title          String
  version        String
  // Null = the document is logged (title/type/version/dates) but no file has
  // been attached — attaching one is optional, and can happen later.
  fileUrl        String?        @map("file_url")
  // When this version of the document was released/issued (for a protocol:
  // the amendment's date, printed in the checklist .docx footer).
  releaseDate    DateTime?      @map("release_date")
  expiryDate     DateTime?      @map("expiry_date")
  status         DocumentStatus @default(ACTIVE)
  signedById     String?        @map("signed_by_id")
  signedAt       DateTime?      @map("signed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  study        Study        @relation(fields: [studyId], references: [id])
  subject      Subject?     @relation(fields: [subjectId], references: [id])
  visit        Visit?       @relation(fields: [visitId], references: [id])
  signedBy     User?        @relation("documentSigner", fields: [signedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([studyId, type])
  @@index([expiryDate])
  @@index([visitId])
  @@map("documents")
}

// Phase 3.5 pilot-testing feedback — not in PROJECT_SPEC.md's data model,
// added because Phase 3.5 ("get it in front of real coordinators") needs
// somewhere for their feedback to land that isn't a scattered Slack thread.
model FeedbackSubmission {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  submittedById   String       @map("submitted_by_id")
  area            FeedbackArea
  confusing       String?
  broken          String?
  suggestion      String?
  easeOfUseRating Int          @map("ease_of_use_rating")
  createdAt       DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  submittedBy  User         @relation(fields: [submittedById], references: [id])

  @@index([organizationId])
  @@map("feedback_submissions")
}

// Append-only. Writes happen exclusively via the audit_trigger_fn() Postgres
// trigger (see the rls_and_audit migration) — application code never inserts
// into this table directly, so the log reflects what actually happened at
// the DB layer even if a bug bypasses app-level logging.
//
// organizationId/actorId are deliberately NOT foreign keys. An audit trail
// has to outlive the rows it describes — including the "organizations" row
// itself: the trigger's own insert while deleting an org would otherwise
// violate a FK to the row being deleted in the same statement, and a
// legitimately deleted user would permanently block deletion via every past
// audit_log row naming them as actor. Confirmed by testing (see README) that
// deleting an org previously failed for exactly this reason before the FK
// was removed.
model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?     @map("organization_id")
  tableName      String      @map("table_name")
  recordId       String      @map("record_id")
  action         AuditAction
  actorId        String?     @map("actor_id")
  before         Json?
  after          Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([tableName, recordId])
  @@map("audit_log")
}

// A visit FROM a monitor (CRA) to the site for one study: on a date, at a time, in
// a room, with its own list of points to verify (MonitoringVisitItem) that can be
// printed like a visit's procedure checklist. Shown in the visit calendar and in
// the shared calendar feed, and included in the weekly heads-up message.
// Tenant-scoped: has RLS + the audit trigger (see its migration).
model MonitoringVisit {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  studyId        String   @map("study_id")
  // Day only, stored at noon UTC like every other visit date (parseDateOnly).
  visitDate      DateTime @map("visit_date")
  // "HH:mm" on the clinic's wall clock, or null.
  startTime      String?  @map("start_time")
  room           String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  study        Study                 @relation(fields: [studyId], references: [id])
  items        MonitoringVisitItem[]

  @@index([organizationId, visitDate])
  @@index([studyId])
  @@map("monitoring_visits")
}

// One point to verify during a monitoring visit, ticked off as it is checked.
// Tenant-scoped like its visit.
model MonitoringVisitItem {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  monitoringVisitId String   @map("monitoring_visit_id")
  label             String
  detail            String?
  sortOrder         Int      @default(0) @map("sort_order")
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [organizationId], references: [id])
  monitoringVisit MonitoringVisit @relation(fields: [monitoringVisitId], references: [id], onDelete: Cascade)

  @@index([monitoringVisitId])
  @@index([organizationId])
  @@map("monitoring_visit_items")
}

// A one-time "choose a new password" link sent by email (src/lib/password-reset.ts).
// Only the SHA-256 of the token is stored. NOT tenant-scoped and not reachable by
// the app's normal database role: like the sign-in lookup, a reset starts from an
// email address alone, before anyone's organization is known, so it goes through
// the owner-role client (prisma-auth.ts) and app_runtime has no access at all (see
// its migration).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
