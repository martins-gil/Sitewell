// Sitepilot — Clinical Trial Site Platform
// Prisma schema per PROJECT_SPEC.md section 3.
// Row-level security (organization_id isolation) and the audit-log trigger
// are added as raw SQL in prisma/migrations/<ts>_rls_and_audit/migration.sql
// — Prisma's schema language cannot express RLS policies or triggers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: the least-privilege app_runtime role (RLS-bound).
  url       = env("DATABASE_URL")
  // Migrations/seed connection: the owner role (full privileges, bypasses RLS).
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CRC
  PI
  ORG_ADMIN
  PLATFORM_ADMIN
}

enum SubjectStatus {
  IDENTIFIED
  PRE_SCREENED
  SCREENED
  CONSENTED
  ENROLLED
  SCREEN_FAILED
  WITHDRAWN
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  MISSED
  RESCHEDULED
}

enum DocumentType {
  PROTOCOL
  IB
  ICF
  DELEGATION_LOG
  TRAINING_RECORD
  OTHER
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUPERSEDED
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

enum FeedbackArea {
  RECRUITMENT
  VISITS
  DOCUMENTS
  STUDIES
  LOGIN_AND_SECURITY
  OTHER
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  plan              String   @default("pilot")
  region            String?
  hostingPreference String?  @map("hosting_preference")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  users                User[]
  studies              Study[]
  sites                Site[]
  subjects             Subject[]
  studyAssignments     StudyAssignment[]
  templates            VisitScheduleTemplate[]
  visits               Visit[]
  documents            Document[]
  feedbackSubmissions  FeedbackSubmission[]
  checklistItems       ChecklistTemplateItem[]
  checklistResults     VisitChecklistResult[]
  checklistTaskLibrary ChecklistTaskLibrary[]
  kits                 Kit[]

  @@map("organizations")
}

model User {
  id              String   @id @default(cuid())
  organizationId  String?  @map("organization_id")
  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  role            UserRole
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")

  mfaEnabled Boolean @default(false) @map("mfa_enabled")
  mfaSecret  String? @map("mfa_secret")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization        Organization?        @relation(fields: [organizationId], references: [id])
  studyAssignments    StudyAssignment[]
  signedDocuments     Document[]           @relation("documentSigner")
  feedbackSubmissions FeedbackSubmission[]

  @@index([organizationId])
  @@map("users")
}

model Study {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  protocolId        String    @map("protocol_id")
  title             String
  phase             String?
  status            String    @default("active")
  sponsor           String?
  protocolAmendment String?   @map("protocol_amendment")
  // Explicit document-header fields for the generated checklist .docx (see
  // src/lib/checklist-docx.ts) — set directly on the study rather than
  // derived from study_assignments/"today", since the printed PI name and
  // protocol date are fixed facts about the protocol document itself, not
  // whoever happens to be logged in or whenever someone downloads a copy.
  piName            String?   @map("pi_name")
  protocolDate      DateTime? @map("protocol_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id])
  sites        Site[]
  subjects     Subject[]
  templates    VisitScheduleTemplate[]
  documents    Document[]
  assignments  StudyAssignment[]
  visits       Visit[]
  kits         Kit[]

  @@unique([organizationId, protocolId])
  @@index([organizationId])
  @@map("studies")
}

model Site {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  studyId        String?  @map("study_id")
  name           String
  address        String?
  siteNumber     String?  @map("site_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  study        Study?       @relation(fields: [studyId], references: [id])

  @@index([organizationId])
  @@map("sites")
}

model StudyAssignment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  studyId        String   @map("study_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id])
  study        Study        @relation(fields: [studyId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, studyId])
  @@index([organizationId])
  @@map("study_assignments")
}

model Subject {
  id                 String        @id @default(cuid())
  organizationId     String        @map("organization_id")
  studyId            String        @map("study_id")
  subjectCode        String        @map("subject_code")
  status             SubjectStatus @default(IDENTIFIED)
  referralSource     String?       @map("referral_source")
  ieCriteriaSnapshot Json?         @map("ie_criteria_snapshot")
  isTestData         Boolean       @default(true) @map("is_test_data")
  enrolledAt         DateTime?     @map("enrolled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  study        Study        @relation(fields: [studyId], references: [id])
  visits       Visit[]
  documents    Document[]

  @@unique([studyId, subjectCode])
  @@index([organizationId])
  @@index([studyId, status])
  @@map("subjects")
}

model VisitScheduleTemplate {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  studyId          String   @map("study_id")
  name             String
  targetDayOffset  Int      @map("target_day_offset")
  windowBeforeDays Int      @default(0) @map("window_before_days")
  windowAfterDays  Int      @default(0) @map("window_after_days")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  study          Study                   @relation(fields: [studyId], references: [id])
  visits         Visit[]
  organization   Organization            @relation(fields: [organizationId], references: [id])
  checklistItems ChecklistTemplateItem[]
  kits           Kit[]

  @@index([organizationId])
  @@index([studyId])
  @@map("visit_schedule_templates")
}

// One row per procedure/assessment step on a visit type's paper checklist
// (e.g. "Registo no IWRS", "Colheita de sangue"). Belongs to the visit TYPE
// (VisitScheduleTemplate), not to an individual subject's visit — every
// subject's "Baseline" visit shares the same checklist definition.
model ChecklistTemplateItem {
  id                      String   @id @default(cuid())
  organizationId          String   @map("organization_id")
  visitScheduleTemplateId String   @map("visit_schedule_template_id")
  sortOrder               Int      @default(0) @map("sort_order")
  label                   String
  detail                  String?
  createdAt               DateTime @default(now()) @map("created_at")

  visitScheduleTemplate VisitScheduleTemplate  @relation(fields: [visitScheduleTemplateId], references: [id])
  organization          Organization           @relation(fields: [organizationId], references: [id])
  results               VisitChecklistResult[]

  @@index([organizationId])
  @@index([visitScheduleTemplateId])
  @@map("checklist_template_items")
}

// A reusable catalog of checklist step descriptions, org-wide, so adding a
// checklist item to a new visit type can pick from what other templates
// already use instead of retyping the same wording every time. Purely a
// suggestion source for the "Add a checklist item" form — copying a library
// entry into a template does not link back to it, so editing/removing a
// library entry never touches templates that already used it.
model ChecklistTaskLibrary {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  label          String
  detail         String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, label])
  @@index([organizationId])
  @@map("checklist_task_library")
}

// Physical/lab kit inventory — a batch of kits earmarked for a specific
// visit type (e.g. "Baseline blood draw kits, Lot #4521"), with an expiry
// date. Not tied to an individual subject's visit; this is site inventory,
// not a per-subject dispensing log.
model Kit {
  id                      String    @id @default(cuid())
  organizationId          String    @map("organization_id")
  studyId                 String    @map("study_id")
  visitScheduleTemplateId String?   @map("visit_schedule_template_id")
  name                    String
  expiryDate              DateTime? @map("expiry_date")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  organization          Organization           @relation(fields: [organizationId], references: [id])
  study                 Study                  @relation(fields: [studyId], references: [id])
  visitScheduleTemplate VisitScheduleTemplate? @relation(fields: [visitScheduleTemplateId], references: [id])

  @@index([organizationId])
  @@index([studyId])
  @@map("kits")
}

model Visit {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  subjectId      String      @map("subject_id")
  studyId        String      @map("study_id")
  templateId     String?     @map("template_id")
  visitType      String      @map("visit_type")
  targetDate     DateTime    @map("target_date")
  windowStart    DateTime    @map("window_start")
  windowEnd      DateTime    @map("window_end")
  actualDate     DateTime?   @map("actual_date")
  status         VisitStatus @default(SCHEDULED)
  reminderSentAt DateTime?   @map("reminder_sent_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  subject          Subject                @relation(fields: [subjectId], references: [id])
  study            Study                  @relation(fields: [studyId], references: [id])
  template         VisitScheduleTemplate? @relation(fields: [templateId], references: [id])
  organization     Organization           @relation(fields: [organizationId], references: [id])
  documents        Document[]
  checklistResults VisitChecklistResult[]

  @@index([organizationId])
  @@index([studyId, targetDate])
  @@index([subjectId])
  @@map("visits")
}

// One row per (visit, checklist item) pair — the "Verificado" checkbox state
// for that specific subject's visit. Created lazily the first time the
// visit's checklist is viewed (see ensureChecklistResults in queries.ts).
model VisitChecklistResult {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  visitId        String   @map("visit_id")
  templateItemId String   @map("template_item_id")
  verified       Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at")

  visit        Visit                 @relation(fields: [visitId], references: [id])
  templateItem ChecklistTemplateItem @relation(fields: [templateItemId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])

  @@unique([visitId, templateItemId])
  @@index([organizationId])
  @@map("visit_checklist_results")
}

model Document {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  studyId        String         @map("study_id")
  subjectId      String?        @map("subject_id")
  visitId        String?        @map("visit_id")
  type           DocumentType
  title          String
  version        String
  fileUrl        String         @map("file_url")
  expiryDate     DateTime?      @map("expiry_date")
  status         DocumentStatus @default(ACTIVE)
  signedById     String?        @map("signed_by_id")
  signedAt       DateTime?      @map("signed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  study        Study        @relation(fields: [studyId], references: [id])
  subject      Subject?     @relation(fields: [subjectId], references: [id])
  visit        Visit?       @relation(fields: [visitId], references: [id])
  signedBy     User?        @relation("documentSigner", fields: [signedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([studyId, type])
  @@index([expiryDate])
  @@index([visitId])
  @@map("documents")
}

// Phase 3.5 pilot-testing feedback — not in PROJECT_SPEC.md's data model,
// added because Phase 3.5 ("get it in front of real coordinators") needs
// somewhere for their feedback to land that isn't a scattered Slack thread.
model FeedbackSubmission {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  submittedById   String       @map("submitted_by_id")
  area            FeedbackArea
  confusing       String?
  broken          String?
  suggestion      String?
  easeOfUseRating Int          @map("ease_of_use_rating")
  createdAt       DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  submittedBy  User         @relation(fields: [submittedById], references: [id])

  @@index([organizationId])
  @@map("feedback_submissions")
}

// Append-only. Writes happen exclusively via the audit_trigger_fn() Postgres
// trigger (see the rls_and_audit migration) — application code never inserts
// into this table directly, so the log reflects what actually happened at
// the DB layer even if a bug bypasses app-level logging.
//
// organizationId/actorId are deliberately NOT foreign keys. An audit trail
// has to outlive the rows it describes — including the "organizations" row
// itself: the trigger's own insert while deleting an org would otherwise
// violate a FK to the row being deleted in the same statement, and a
// legitimately deleted user would permanently block deletion via every past
// audit_log row naming them as actor. Confirmed by testing (see README) that
// deleting an org previously failed for exactly this reason before the FK
// was removed.
model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?     @map("organization_id")
  tableName      String      @map("table_name")
  recordId       String      @map("record_id")
  action         AuditAction
  actorId        String?     @map("actor_id")
  before         Json?
  after          Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([tableName, recordId])
  @@map("audit_log")
}
