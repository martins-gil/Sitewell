# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Two URLs, both pointing at the same Postgres instance:
#
# DATABASE_URL   — used by the running app. Must connect as the least-privilege
#                  "app_runtime" role created in the rls_and_audit migration
#                  (NOT the table owner — table owners bypass row-level security).
# DIRECT_URL     — used by `prisma migrate` / `prisma db seed`. Must connect as
#                  the owner role (e.g. the default role Neon/Supabase gives you),
#                  since RLS setup and schema changes need full privileges and
#                  RLS-bypass.
#
# Fastest path per PROJECT_SPEC.md section 8: create a free Neon (neon.tech) or
# Supabase (supabase.com) Postgres project, then paste its connection string
# below for DIRECT_URL, and use the app_runtime credentials (from the migration
# you'll run) for DATABASE_URL.
DATABASE_URL="postgresql://app_runtime:CHANGE_ME@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://owner_role:CHANGE_ME@host:5432/dbname?sslmode=require"

# --- Auth ---
# Generate with: npx auth secret
AUTH_SECRET="CHANGE_ME"

# --- App ---
NEXTAUTH_URL="http://localhost:3000"

# --- Email (optional) ---
# Visit reminders (src/lib/reminders.ts) and kit-expiry emails
# (src/lib/kit-reminders.ts) log to the console when this is unset. Set it to
# send real email via Resend (resend.com). Note that Resend's default
# onboarding@resend.dev sender only delivers to the address the Resend account
# was registered with — to email the whole team you have to verify a domain in
# Resend and set EMAIL_FROM to an address on it.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="SiteWell-ct <alerts@your-verified-domain.com>"

# --- Document storage ---
# Unset = documents are saved to the local `uploads/` folder (fine for
# development, but Vercel has no persistent disk, so the deployed site needs
# these). All four must be set to use Cloudflare R2. Keep the bucket PRIVATE:
# downloads go through the app, which checks who is asking.
#   R2_ENDPOINT   the bucket's S3 API address from the Cloudflare dashboard —
#                 for an EU-jurisdiction bucket https://<account id>.eu.r2.cloudflarestorage.com
#   R2_BUCKET     the bucket's name
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY   from an R2 API token limited to
#                 "Object Read & Write" on that one bucket
# R2_ENDPOINT="https://<account id>.eu.r2.cloudflarestorage.com"
# R2_BUCKET="sitewell-documents"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."

# --- AI (optional) ---
# Everything works without this: pasted I/E criteria and checklist text are split
# with built-in rules, and the Help assistant lists the closest articles instead
# of writing an answer. With a key (console.anthropic.com), the same screens use
# Claude for a better reading / a written answer. Only protocol text the user
# pastes and Help questions are sent — never patient data. Billed per use.
# ANTHROPIC_API_KEY="sk-ant-..."
# Model to use; defaults to claude-opus-5. Set a cheaper one to lower the cost.
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- Sign-in help, notifications ---
# These need the email service above (RESEND_API_KEY, and a verified domain in
# Resend so mail can reach people other than the account owner). Without it the
# "Forgot password" and "Request access" pages say they aren't set up, and the
# weekly visit message is only written to the server log.
#   ACCESS_REQUEST_EMAIL  who receives "Request access" emails (comma-separated
#                         addresses — the site administrator(s)).
#   NEXTAUTH_URL          also the address put in password-reset and message links:
#                         set it to the site's real address (https://…) on Vercel.
# ACCESS_REQUEST_EMAIL="admin@your-organisation.example"
#
# Text messages (SMS) for the weekly visit message, via Twilio — optional. People
# opt in themselves under Settings → Notifications; without these the text is only
# written to the server log.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+351..."                  # or a Messaging Service instead:
# TWILIO_MESSAGING_SERVICE_SID="MG..."
#
# Language of the dates in the weekly message (default en-GB).
# DIGEST_LOCALE="pt-PT"

# --- Cron ---
# /api/cron/kit-expiry (run daily by Vercel Cron, see vercel.json) refuses to
# run unless this is set, and only accepts requests carrying it as a Bearer
# token — Vercel sends that header automatically when the variable exists on
# the project. Any long random string works.
# CRON_SECRET="CHANGE_ME"
